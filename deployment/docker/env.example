# AI Control System - Development Environment Variables

# Database Configuration
POSTGRES_DB=ai_control_dev
POSTGRES_USER=ai_control_user
POSTGRES_PASSWORD=ai_control_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# RabbitMQ Configuration
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=ai_control_user
RABBITMQ_PASSWORD=ai_control_password
RABBITMQ_VHOST=/

# Backend Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_WORKERS=1
BACKEND_RELOAD=true

# Frontend Configuration
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=3000
REACT_APP_API_URL=http://localhost:8000
REACT_APP_WS_URL=ws://localhost:8000

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-jwt-key-for-development-only
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Email Configuration (for development)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# File Storage (local for development)
FILE_STORAGE_BACKEND=local
FILE_STORAGE_PATH=/app/uploads
MAX_FILE_SIZE=10485760  # 10MB

# Logging
LOG_LEVEL=DEBUG
LOG_FORMAT=json

# Security
SECRET_KEY=your-super-secret-key-for-development-only
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# External Services (optional for development)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SLACK_BOT_TOKEN=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
FLOWER_PORT=5555

# Development specific
DEBUG=true
ENVIRONMENT=development

# Rust dashboard SQLite engine (optional; sidecar beside FastAPI).
# Build: `cargo run -p dashboard-query-server` under `rust/dashboard-query`.
# Включите и поднимите Rust-сервис (rust/dashboard-query), чтобы SQLite dashboard шёл через него.
SQLITE_QUERY_RUST__ENABLED=true
SQLITE_QUERY_RUST__BASE_URL=http://127.0.0.1:8787
SQLITE_QUERY_RUST__TIMEOUT_SEC=120
# false: do not run Python SQLite after Rust HTTP timeout (avoids doubled CPU/DB load when sidecar is saturated).
SQLITE_QUERY_RUST__PYTHON_FALLBACK_ON_TIMEOUT=false
# Redis cache (Python sqlite_query_rust_gateway): включайте если Redis доступен по URL ниже.
# В корневом docker-compose сервис `redis`; URL из контейнеров backend: redis://redis:6379/0
SQLITE_QUERY_RUST__CACHE_ENABLED=true
# Hit/miss: DEBUG у логгера `app.services.sqlite_query_rust_gateway`
SQLITE_QUERY_RUST__CACHE_REDIS_URL=redis://redis:6379/0
SQLITE_QUERY_RUST__CACHE_TTL_SEC=120
SQLITE_QUERY_RUST__CACHE_KEY_PREFIX=sqlite_rust
SQLITE_QUERY_RUST__CACHE_TIMEOUT_SEC=0.2

# Rust dashboard-query tuning
# DASHBOARD_QUERY_MAX_INFLIGHT_BATCH=8
# DASHBOARD_QUERY_BATCH_WORKERS=4
# DASHBOARD_QUERY_SCHEMA_CACHE_MAX_ENTRIES=256
# DASHBOARD_QUERY_STRICT_JOIN_PATH=false
# DASHBOARD_QUERY_BLOB_MODE=array

# Optional Rust sidecars (scaffold): task reports + tabular file pipeline — see rust/README.md
# TASK_REPORTING_RUST__ENABLED=false
# TASK_REPORTING_RUST__BASE_URL=http://127.0.0.1:8790
# TASK_REPORTING_RUST__TIMEOUT_SEC=120
# FILE_PIPELINE_RUST__ENABLED=false
# FILE_PIPELINE_RUST__BASE_URL=http://127.0.0.1:8791
# FILE_PIPELINE_RUST__TIMEOUT_SEC=300
