# PartyHome / calls (AiControl frontend)

# Dev proxy target for signaling (default http://127.0.0.1:8989)
# VITE_DEV_PROXY_PARTYHOME_TARGET=http://127.0.0.1:8989

# Must match SIGNALING_DEV_TOKEN on the PartyHome signaling server
# VITE_PARTYHOME_TOKEN=dev

# Production: absolute signaling base (skip same-origin /api/partyhome proxy)
# VITE_PARTYHOME_URL=https://calls.example.com
